# Copy to bot/.env and fill in. Never commit .env.

# --- Agent ---------------------------------------------------------------
# Optional. When set, the agent runs `claude --bare` (smaller context per turn)
# and bills this key. When unset, it uses your Claude Code login.
ANTHROPIC_API_KEY=
FIREBREAK_MODEL=sonnet
FIREBREAK_MAX_USD=1

# --- Slack (optional; without it, approve on http://127.0.0.1:4100) ------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL=#incidents
# Comma-separated Slack user IDs allowed to approve. Empty = anyone in the channel.
SLACK_APPROVERS=

# --- Board -----------------------------------------------------------------
PORT=4100
HOST=127.0.0.1
